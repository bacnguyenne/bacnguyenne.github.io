---
import type { Project } from '../data/portfolio';

interface Props {
	project: Project;
}
const { project } = Astro.props;
const { title, blurb, tech, result, context, year, repo, demo } = project;
---

<article class="pcard">
	<div class="pcard-body">
		<div class="pcard-head">
			<h3 class="pcard-title">{title}</h3>
			<span class="pcard-year">{year}</span>
		</div>
		{context && <p class="pcard-context">{context}</p>}
		<p class="pcard-blurb">{blurb}</p>
		{result && <p class="pcard-result">{result}</p>}
		<div class="pcard-tech">
			{tech.map((t) => <span class="chip">{t}</span>)}
		</div>
		<div class="pcard-links">
			{
				repo && (
					<a href={repo} target="_blank" rel="noopener">
						<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
						</svg>
						Code
					</a>
				)
			}
			{
				demo && (
					<a href={demo} target="_blank" rel="noopener">
						Live ↗
					</a>
				)
			}
		</div>
	</div>
</article>

<style>
	.pcard {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 0.18s ease;
	}
	.pcard:hover {
		border-color: var(--border-strong);
	}
	.pcard-body {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		flex: 1;
		padding: 1.3rem 1.4rem 1.5rem;
	}
	.pcard-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
	}
	.pcard-title {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.25;
		color: var(--heading);
	}
	.pcard-year {
		flex-shrink: 0;
		font-size: 0.8rem;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}
	.pcard-context {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--accent);
	}
	.pcard-blurb {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		flex: 1;
	}
	.pcard-result {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--heading);
		padding: 0.45rem 0.7rem;
		background: var(--surface-2);
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
	}
	.pcard-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.chip {
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--text-muted);
		background: var(--surface-2);
		border: 1px solid var(--border);
		padding: 0.15rem 0.5rem;
		border-radius: 6px;
	}
	.pcard-links {
		display: flex;
		gap: 1rem;
		margin-top: 0.2rem;
	}
	.pcard-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent);
	}
	.pcard-links a:hover {
		text-decoration: underline;
	}
</style>
