---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { readingTime } from '../lib/reading-time';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const mins = readingTime(post.body);
const href = `/blog/${post.id}/`;
---

<article class:list={['card', { featured }]}>
	<div class="card-top" aria-hidden="true"></div>
	<div class="card-body">
		{
			tags && tags.length > 0 && (
				<div class="tag-row">
					{tags.slice(0, 3).map((t) => (
						<span class="tag">{t}</span>
					))}
				</div>
			)
		}
		<h3 class="card-title"><a href={href}>{title}</a></h3>
		<p class="card-excerpt">{description}</p>
		<div class="card-meta muted">
			<FormattedDate date={pubDate} />
			<span aria-hidden="true">·</span>
			<span>{mins} min read</span>
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		transition:
			transform 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.25s ease;
	}
	.card:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
		box-shadow: var(--shadow-lg);
	}
	.card-top {
		height: 4px;
		background: var(--grad);
		opacity: 0.85;
	}
	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		flex: 1;
		padding: 1.25rem 1.3rem 1.4rem;
	}
	.card-title {
		margin: 0;
		font-size: 1.22rem;
		line-height: 1.25;
	}
	.card-title a {
		color: var(--heading);
	}
	.card-title a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.card-excerpt {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.97rem;
		flex: 1;
	}
	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.84rem;
		margin-top: 0.4rem;
	}
	.card.featured .card-body {
		padding: 1.8rem 1.8rem 2rem;
	}
	.card.featured .card-title {
		font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2rem);
	}
	.card.featured .card-excerpt {
		font-size: 1.05rem;
	}
</style>
