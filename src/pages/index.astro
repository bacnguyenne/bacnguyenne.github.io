---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { PROJECTS } from '../data/portfolio';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 4);
const featured = PROJECTS.filter((p) => p.featured).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header />
		<main id="main">
			<section class="hero container container-narrow">
				<h1>Bac Nguyen</h1>
				<p class="hero-role muted">AI Engineer · Software-defined vehicles · Ho Chi Minh City</p>
				<p class="hero-sub">
					I build computer-vision and edge-AI pipelines, virtual vehicle simulation, and multi-agent
					systems — with a research background in speech, vision, and NLP. This site is my work and
					what I've learned shipping it.
				</p>
				<div class="hero-cta">
					<a class="btn btn-primary" href="/projects/">View projects</a>
					<a class="btn" href="/blog/">Read the blog</a>
					<a class="btn" href={GITHUB_URL} target="_blank" rel="me noopener">
						GitHub<span class="sr-only"> (opens in a new tab)</span>
					</a>
				</div>
			</section>

			<section class="container block">
				<div class="block-head">
					<h2>Selected work</h2>
					<a class="more" href="/projects/">All projects →</a>
				</div>
				<div class="grid">
					{featured.map((p) => <ProjectCard project={p} />)}
				</div>
			</section>

			{
				latest.length > 0 && (
					<section class="container container-narrow block">
						<div class="block-head">
							<h2>Writing</h2>
							<a class="more" href="/blog/">
								All posts →
							</a>
						</div>
						<div class="post-list">
							{latest.map((p) => (
								<PostCard post={p} />
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: clamp(3rem, 2rem + 4vw, 5rem) 1.25rem 1.5rem;
	}
	.hero h1 {
		margin: 0 0 0.35rem;
	}
	.hero-role {
		font-size: 0.95rem;
		margin: 0 0 1.2rem;
	}
	.hero-sub {
		font-size: 1.1rem;
		color: var(--text);
		max-width: 38rem;
		margin: 0 0 1.6rem;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.block {
		margin-top: 3.5rem;
	}
	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}
	.block-head h2 {
		margin: 0;
	}
	.more {
		color: var(--text-muted);
		font-size: 0.92rem;
		font-weight: 500;
		white-space: nowrap;
	}
	.more:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}
	.post-list {
		border-top: 1px solid var(--border);
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
