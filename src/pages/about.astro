---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, EMAIL_URL, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import { EDUCATION, EXPERIENCE, SKILLS } from '../data/portfolio';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About — ${SITE_TITLE}`}
			description="Bac Nguyen (Nguyễn Đình Nguyên Bắc) — AI Engineer and Data Science graduate. Experience, research, education, and skills."
		/>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header />
		<main id="main">
			<section class="container container-narrow about">
				<h1>Nguyễn Đình Nguyên Bắc</h1>
				<p class="role muted">AI Engineer — software-defined vehicles</p>
				<p class="bio-lead">
					I build production AI for software-defined vehicles: computer-vision and edge-AI
					pipelines, virtual vehicle simulation, and multi-agent systems. Before that, applied
					research in speech, vision, and NLP — including a research internship at National
					Chung Cheng University (Taiwan).
				</p>
				<p class="contact muted">
					<a href={EMAIL_URL}>{EMAIL}</a>
					<span aria-hidden="true">·</span>
					<a href={GITHUB_URL} target="_blank" rel="me noopener">GitHub</a>
					<span aria-hidden="true">·</span>
					<a href={LINKEDIN_URL} target="_blank" rel="me noopener">LinkedIn</a>
				</p>

				<div class="prose bio">
					<p>
						I graduated in Data Science from the Industrial University of Ho Chi Minh City and now
						work at AutoNxt AI. I care most about the engineering that turns a promising model into
						something dependable — the pipeline, the evaluation, and the scaffolding that makes it
						safe to ship. Lessons from that work end up on the <a href="/blog/">blog</a>; the
						projects live on the <a href="/projects/">projects page</a>.
					</p>
				</div>

				<h2 class="sec">Experience</h2>
				<div class="timeline">
					{
						EXPERIENCE.map((e) => (
							<div class="tl-item">
								<div class="tl-head">
									<span class="tl-role">{e.role} · {e.org}</span>
									<span class="tl-period">{e.period}</span>
								</div>
								<div class="tl-org muted">{e.location}</div>
								<ul>
									{e.points.map((p) => (
										<li>{p}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<h2 class="sec">Education</h2>
				<div class="tl-item">
					<div class="tl-head">
						<span class="tl-role">{EDUCATION.school}</span>
						<span class="tl-period">{EDUCATION.period}</span>
					</div>
					<div class="tl-org muted">{EDUCATION.degree}</div>
					<p class="muted edu-detail">{EDUCATION.detail}</p>
				</div>

				<h2 class="sec">Skills</h2>
				<div class="skills">
					{
						SKILLS.map((s) => (
							<div class="skill-group">
								<span class="skill-label">{s.group}</span>
								<div class="tag-row">
									{s.items.map((i) => (
										<span class="tag">{i}</span>
									))}
								</div>
							</div>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		padding: clamp(3rem, 2rem + 4vw, 4.5rem) 1.25rem 1rem;
	}
	.about h1 {
		margin: 0 0 0.35rem;
	}
	.role {
		font-size: 0.95rem;
		margin: 0 0 1.2rem;
	}
	.bio-lead {
		font-size: 1.1rem;
		margin: 0 0 0.9rem;
		max-width: 38rem;
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		font-size: 0.95rem;
		margin: 0 0 2rem;
	}
	.bio {
		font-size: 1rem;
	}
	.sec {
		margin: 2.75rem 0 1.1rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
	}
	.timeline {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.tl-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.2rem 1rem;
		align-items: baseline;
	}
	.tl-role {
		font-weight: 600;
		color: var(--heading);
	}
	.tl-period {
		font-size: 0.85rem;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.tl-org {
		font-size: 0.9rem;
		margin-top: 0.1rem;
	}
	.tl-item ul {
		margin: 0.55rem 0 0;
		padding-left: 1.2rem;
	}
	.tl-item li {
		color: var(--text-muted);
		font-size: 0.97rem;
	}
	.tl-item li + li {
		margin-top: 0.35rem;
	}
	.edu-detail {
		margin: 0.4rem 0 0;
		font-size: 0.95rem;
	}
	.skills {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.skill-group {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 0.5rem 1rem;
		align-items: start;
	}
	.skill-label {
		font-weight: 600;
		color: var(--heading);
		font-size: 0.9rem;
		padding-top: 0.15rem;
	}
	@media (max-width: 560px) {
		.skill-group {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}
</style>
